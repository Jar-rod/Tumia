<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the important infrastructure rules on the synthesised CloudFormation. Needs Node.js (the CDK runs on it). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Use the classic VSTest runner, as in services/api. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tumiia.Infra\Tumiia.Infra.csproj" />
  </ItemGroup>

</Project>
