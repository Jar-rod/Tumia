    "/api/v1/projects/{projectId}/documents": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "Lists a project's documents, newest first.",
        "description": "Filter by `status` (for example NeedsReview) and by `category` (the confirmed document type). Unfinished uploads are left out unless you ask for status PendingUpload.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "The project id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Only documents with this status.",
            "schema": {
              "$ref": "#/components/schemas/DocumentStatus"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Only documents with this confirmed document type.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentResponse"
                  }
                }
              }
