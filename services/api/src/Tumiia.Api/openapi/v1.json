        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Open or download the file here. PDFs and images open in the browser; other files download."
          },
          "expiresAt": {
            "type": "string",
            "description": "When the address stops working (UTC). Ask again after that.",
            "format": "date-time"
          }
        },
        "description": "A short-lived address for the original file."
      },
      "UploadFileRequest": {
        "required": [
          "fileName",
          "contentType",
          "sizeBytes",
          "sha256"
        ],
        "type": "object",
        "properties": {
          "fileName": {
            "maxLength": 255,
            "type": "string",
            "description": "The file's name, with its extension."
          },
          "contentType": {
            "maxLength": 255,
            "type": "string",
            "description": "The file's type as the browser reports it (for example `application/pdf`). Must be sent again, exactly, on the upload."
          },
          "sizeBytes": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The file's size in bytes. The upload must be exactly this size.",
            "format": "int64"
          },
          "sha256": {
            "pattern": "^[0-9a-fA-F]{64}$",
            "type": "string",
            "description": "The SHA-256 of the file's bytes, as 64 hexadecimal characters (Web Crypto `crypto.subtle.digest`)."
          }
        },
        "description": "One file the browser wants to upload."
      },
      "UploadRequestsRequest": {
        "required": [
          "captureSource",
          "files"
        ],
        "type": "object",
        "properties": {
          "captureSource": {
            "description": "How the files were picked: `drag_drop`, `file_picker` or `mobile_upload`.",
            "$ref": "#/components/schemas/CaptureSource"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadFileRequest"
            },
            "description": "The files. At most 50 per request (configurable)."
          }
        },
        "description": "The files the browser wants to upload in one go, and how they were picked."
      },
      "UploadRequestsResponse": {
        "required": [
          "files"
        ],
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadTargetResponse"
            },
            "description": "The answers."
          }
        },
        "description": "One answer per requested file, in the order sent."
      },
      "UploadTargetResponse": {
        "required": [
          "fileName",
          "documentId",
          "uploadUrl",
          "existingDocumentId"
        ],
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "The file name as sent, to match answers to files."
          },
          "documentId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The new document's id, when the file should be uploaded.",
