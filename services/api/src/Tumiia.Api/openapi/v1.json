            "type": "string",
            "description": "Who uploaded it.",
            "format": "uuid"
          },
          "correctionFlag": {
            "type": "boolean",
            "description": "True once a person changed something the AI proposed."
          },
          "confirmedBy": {
            "type": [
              "null",
              "string"
            ],
            "description": "Who confirmed it, if anyone.",
            "format": "uuid"
          },
          "confirmedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When it was confirmed (UTC).",
            "format": "date-time"
