    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Swaps the refresh token cookie for a new access token (and a new refresh token).",
        "description": "Call this when the app loads, and after a 401, to stay signed in. If an old refresh token is used again, the\nwhole sign-in is ended for safety.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
