          },
          "user": {
            "description": "Who is signed in.",
            "$ref": "#/components/schemas/CurrentUserResponse"
          }
        },
        "description": "A signed-in session. The access token goes in the `Authorization: Bearer` header and should be kept in\nmemory only. The refresh token is not in the body: it is set as an HttpOnly cookie."
      },
      "CaptureSource": {
        "enum": [
          "drag_drop",
          "file_picker",
          "mobile_upload"
        ]
      },
      "ConsequenceLevel": {
        "enum": [
