    "/api/v1/projects/{projectId}/documents/upload-requests": {
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Step 1 of uploading: get an upload address for each file.",
        "description": "Send up to 50 files' names, types, sizes and SHA-256 hashes. Each new file gets a document id and a 5-minute\npre-signed address to PUT the file to, with exactly that Content-Type and size. A file already in the project\ngets `existingDocumentId` instead. Files with a type TUMIIA does not take, or over 50 MB, are refused\nwith 400, and then nothing is created.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "description": "The project id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
