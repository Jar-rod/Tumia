{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tumiia-api",
    "Audience": "tumiia-web",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Upload": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Default": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "Provider": "Logging"
  },
  "Admin": {
    "Emails": ""
  }
}
