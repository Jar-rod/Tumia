{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tumiia-api",
    "Audience": "tumiia-web",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Upload": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Default": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "Provider": "Logging"
  },
  "Admin": {
    "Emails": ""
  },
  "Uploads": {
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".heic",
      ".tif",
      ".tiff",
      ".webp",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".csv",
      ".txt",
      ".dxf",
      ".dwg"
    ],
    "MaxFileSizeMb": 50,
    "MaxFilesPerRequest": 50
  },
  "Aws": {
    "Region": "af-south-1"
  },
  "Bedrock": {
    "Enabled": false,
    "Region": "af-south-1",
    "ModelId": "anthropic.claude-haiku-5-5",
    "Effort": "low"
  },
  "Analysis": {
    "WorkerEnabled": true,
    "MaxAttempts": 3,
    "Weights": {
      "WinnerProbability": 0.3,
      "Margin": 0.15,
      "Readability": 0.15,
      "Agreement": 0.2,
      "ExpectedFieldsFound": 0.1,
      "FormatMatches": 0.1
    }
  }
}
