<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that talks to the outside world: database, S3, SQS, OCR, models, email. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="AWSSDK.SimpleEmailV2" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="MetadataExtractor" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Anthropic.Bedrock" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- The v1.1 categories, keywords and chips. Loaded into the database the first time the taxonomy is read. -->
    <EmbeddedResource Include="Seed\taxonomy.json" LogicalName="Tumiia.Infrastructure.Seed.taxonomy.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tumiia.Application\Tumiia.Application.csproj" />
    <ProjectReference Include="..\Tumiia.Domain\Tumiia.Domain.csproj" />
  </ItemGroup>

</Project>
